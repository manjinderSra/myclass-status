{
  "info": {
    "name": "Teacher API Collection",
    "description": "A collection of requests for testing the Teacher API endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employee_id\": \"TCH-12345\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/teacher/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "teacher",
            "login"
          ]
        },
        "description": "Authenticate a teacher and get a bearer token"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Parse the response",
              "var jsonData = pm.response.json();",
              "",
              "// Check if login was successful",
              "if (jsonData.success === true && jsonData.token) {",
              "    // Save the token to a variable for use in other requests",
              "    pm.environment.set('teacher_token', jsonData.token);",
              "    console.log('Token saved to environment variable: teacher_token');",
              "    ",
              "    // Also save teacher info for reference",
              "    if (jsonData.teacher) {",
              "        pm.environment.set('teacher_id', jsonData.teacher.id);",
              "        pm.environment.set('teacher_name', jsonData.teacher.name);",
              "        pm.environment.set('school_id', jsonData.teacher.school_id);",
              "        pm.environment.set('school_name', jsonData.teacher.school_name || 'Unknown School');",
              "    }",
              "} else {",
              "    console.log('Login failed, token not saved');",
              "}",
              "",
              "// Test assertions",
              "pm.test('Status code is 200', function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has success flag', function() {",
              "    pm.expect(jsonData).to.have.property('success');",
              "});",
              "",
              "pm.test('Response includes school name', function() {",
              "    if (jsonData.success && jsonData.teacher) {",
              "        pm.expect(jsonData.teacher).to.have.property('school_name');",
              "    }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{teacher_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/teacher/profile",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "teacher",
            "profile"
          ]
        },
        "description": "Get the authenticated teacher's profile information"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Parse the response",
              "var jsonData = pm.response.json();",
              "",
              "// Test assertions",
              "pm.test('Status code is 200', function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has success flag', function() {",
              "    pm.expect(jsonData).to.have.property('success');",
              "});",
              "",
              "pm.test('Response includes school name', function() {",
              "    if (jsonData.success && jsonData.teacher) {",
              "        pm.expect(jsonData.teacher).to.have.property('school_name');",
              "    }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{teacher_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/teacher/logout",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "teacher",
            "logout"
          ]
        },
        "description": "Invalidate the current bearer token"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Parse the response",
              "var jsonData = pm.response.json();",
              "",
              "// Test assertions",
              "pm.test('Status code is 200', function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has success flag', function() {",
              "    pm.expect(jsonData).to.have.property('success');",
              "    pm.expect(jsonData.success).to.be.true;",
              "});",
              "",
              "// Clear the token from environment after successful logout",
              "if (jsonData.success === true) {",
              "    pm.environment.unset('teacher_token');",
              "    console.log('Token removed from environment after logout');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Teacher Announcements",
      "item": [
        {
          "name": "Get All Announcements",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{teacher_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/teacher/announcements",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "teacher",
                "announcements"
              ]
            },
            "description": "Get all announcements for the authenticated teacher"
          },
          "response": []
        },
        {
          "name": "Get Announcement Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{teacher_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/teacher/announcements/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "teacher",
                "announcements",
                "1"
              ]
            },
            "description": "Get details of a specific announcement"
          },
          "response": []
        }
      ],
      "description": "API endpoints for teacher announcements"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "teacher_token",
      "value": "",
      "type": "string"
    }
  ]
} 