@push('scripts')
<script>
    function studentBooks() {
        return {
            currentBooks: [],
            returnedBooks: [],
            loading: true,
            error: null,
            
            init() {
                console.log('studentBooks init method called');
                this.fetchIssuedBooks('{{ $student->admission_number }}');
            },
            
            fetchIssuedBooks(studentId) {
                console.log('Fetching books for student:', studentId);
                this.loading = true;
                
                fetch('/school/students/' + studentId + '/issued-books')
                    .then(response => {
                        if (!response.ok) {
                            throw new Error('Network response was not ok');
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (data.success) {
                            this.currentBooks = data.issuedBooks.filter(book => !book.is_returned);
                            this.returnedBooks = data.issuedBooks.filter(book => book.is_returned);
                        } else {
                            this.error = data.message;
                        }
                        this.loading = false;
                    })
                    .catch(error => {
                        this.error = `Failed to load issued books: ${error.message}`;
                        this.loading = false;
                    });
            },
            
            isOverdue(dueDate) {
                return new Date(dueDate) < new Date();
            },
            
            formatDate(dateString) {
                if (!dateString) return 'N/A';
                const date = new Date(dateString);
                const options = { day: '2-digit', month: 'short', year: 'numeric' };
                return date.toLocaleDateString('en-US', options);
            }
        };
    }
    
    function studentTimetable() {
        return {
            timeSlots: [],
            loading: true,
            error: null,
            classId: null,
            sectionId: null,
            
            init() {
                console.log('studentTimetable init method called');
                this.fetchStudentClass('{{ $student->admission_number }}');
            },
            
            fetchStudentClass(studentId) {
                console.log('Fetching class for student:', studentId);
                this.loading = true;
                this.error = null;
                
                fetch('/school/students/' + studentId + '/class', {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                    },
                    credentials: 'same-origin'
                })
                    .then(response => {
                        console.log('Student class API response status:', response.status);
                        if (!response.ok) {
                            throw new Error('Network response was not ok: ' + response.status);
                        }
                        return response.json();
                    })
                    .then(data => {
                        console.log('Student class API response data:', data);
                        if (data.success && data.class) {
                            console.log('Student class data:', data.class);
                            this.classId = data.class.id;
                            this.sectionId = data.class.section_id;
                            this.fetchTimetable(data.class.name, data.class.section_id);
                        } else {
                            this.error = data.message || 'No class information found for this student';
                            this.loading = false;
                        }
                    })
                    .catch(error => {
                        console.error('Error fetching student class:', error);
                        this.error = `Failed to load student class: ${error.message}`;
                        this.loading = false;
                    });
            },
            
            fetchTimetable(className, sectionId) {
                console.log(`Fetching timetable for class: ${className}, section: ${sectionId}`);
                
                fetch(`/school/timeTable/filter?filterClass=${encodeURIComponent(className)}&filterSection=${sectionId}`, {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
                    },
                    credentials: 'same-origin'
                })
                    .then(response => {
                        console.log('Timetable filter API response status:', response.status);
                        if (!response.ok) {
                            throw new Error('Network response was not ok: ' + response.status);
                        }
                        return response.json();
                    })
                    .then(data => {
                        console.log('Timetable filter API response data:', data);
                        if (data.success) {
                            this.processTimetableData(data.data);
                        } else {
                            this.error = data.message || 'Failed to load timetable';
                        }
                        this.loading = false;
                    })
                    .catch(error => {
                        console.error('Error fetching timetable:', error);
                        this.error = `Failed to load timetable: ${error.message}`;
                        this.loading = false;
                    });
            },
            
            processTimetableData(timetableData) {
                console.log('Processing timetable data:', timetableData);
                
                if (!timetableData || timetableData.length === 0) {
                    this.timeSlots = [];
                    return;
                }
                
                // Group periods by time slots
                const timeSlotMap = {};
                timetableData.forEach(period => {
                    const timeKey = `${period.start_time} - ${period.end_time}`;
                    if (!timeSlotMap[timeKey]) {
                        timeSlotMap[timeKey] = {
                            timeSlot: timeKey,
                            days: {
                                'Monday': null,
                                'Tuesday': null,
                                'Wednesday': null,
                                'Thursday': null,
                                'Friday': null,
                                'Saturday': null
                            }
                        };
                    }
                    
                    // Process the period data
                    if (period.period_type === 'regular') {
                        timeSlotMap[timeKey].days[period.day] = {
                            id: period.id,
                            subject_id: period.subject,
                            subject_name: period.subject_name || 'Unknown Subject',
                            teacher_id: period.teacher,
                            teacher_name: period.teacher_name || 'Unknown Teacher',
                            is_extra: false
                        };
                    } else {
                        // Extra period (break, lunch)
                        timeSlotMap[timeKey].days[period.day] = {
                            id: period.id,
                            name: period.name || 'Break',
                            is_extra: true
                        };
                    }
                });
                
                // Convert map to sorted array of time slots
                this.timeSlots = Object.values(timeSlotMap).sort((a, b) => {
                    const aTime = a.timeSlot.split(' - ')[0];
                    const bTime = b.timeSlot.split(' - ')[0];
                    return aTime.localeCompare(bTime);
                });
                
                console.log('Processed time slots:', this.timeSlots);
            },
            
            getSubjectBackgroundColor(subject) {
                if (!subject) return 'bg-gray-100';
                
                if (subject === 'Break' || subject === 'Lunch') return 'bg-orange-100';
                if (subject.includes('Math')) return 'bg-blue-100';
                if (subject.includes('Computer')) return 'bg-green-100';
                if (subject.includes('Physics')) return 'bg-yellow-100';
                if (subject.includes('English')) return 'bg-purple-100';
                if (subject.includes('Spanish')) return 'bg-pink-100';
                if (subject.includes('Chemistry')) return 'bg-red-100';
                
                // Default color
                return 'bg-gray-100';
            }
        };
    }
</script>
@endpush